@prefix : <http://example.org/nfv#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@base <http://example.org/nfv> .

<http://example.org/nfv> rdf:type owl:Ontology ;
                         rdfs:comment "Semantic VNF Placement Ontology - Updated for IEEE TNSM Revision" .

#################################################################
#    Classes
#################################################################

:Server rdf:type owl:Class ;
        rdfs:comment "Any physical or virtual compute node" .

:EdgeServer rdf:type owl:Class ;
            rdfs:subClassOf :Server ;
            rdfs:comment "Low-latency MEC edge node" .

:CoreServer rdf:type owl:Class ;
            rdfs:subClassOf :Server ;
            rdfs:comment "High-capacity core/cloud node" .

:VNF rdf:type owl:Class ;
     rdfs:comment "Virtual Network Function instance" .

:LowLatencyVNF rdf:type owl:Class ;
               rdfs:subClassOf :VNF .

:HardwareAcceleratedVNF rdf:type owl:Class ;
                        rdfs:subClassOf :VNF .

:Zone rdf:type owl:Class ;
      rdfs:comment "Geographical or administrative zone" .

:LowLatencyZone rdf:type owl:Class ;
                rdfs:subClassOf :Zone .

:SecurityDomain rdf:type owl:Class ;
                rdfs:subClassOf :Zone ;
                rdfs:comment "Isolated security/trust domain" .

# --- BỔ SUNG CLASS LINK (Giải quyết phản biện Reviewer 3) ---
:Link rdf:type owl:Class ;
      rdfs:comment "Represents a physical substrate link between servers." .


#################################################################
#    Object Properties
#################################################################

:locatedIn rdf:type owl:ObjectProperty ;
           rdfs:domain :Server ;
           rdfs:range :Zone .

:belongsToSecurityDomain rdf:type owl:ObjectProperty ;
                         rdfs:domain :VNF ;
                         rdfs:range :SecurityDomain .

# --- THAY THẾ IncompatibleNode BẰNG OBJECT PROPERTY (Giải quyết Paradox) ---
:isIncompatibleWith rdf:type owl:ObjectProperty ;
                    rdfs:domain :Server ;
                    rdfs:range :VNF ;
                    rdfs:comment "Indicates that a specific Server cannot host a specific VNF due to policy violations." .

# --- BỔ SUNG LIÊN KẾT CHO LINK ---
:connectsNode rdf:type owl:ObjectProperty ;
              rdfs:domain :Link ;
              rdfs:range :Server ;
              rdfs:comment "Indicates which servers are connected by this link." .


#################################################################
#    Data Properties
#################################################################

# Server Properties
:hasAvailableCPU rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Server ;
                 rdfs:range xsd:integer .

:hasHardwareAccel rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Server ;
                  rdfs:range xsd:boolean .

# Link Properties (Bổ sung theo yêu cầu R3)
:hasLinkBandwidth rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Link ;
                  rdfs:range xsd:integer .

:hasLinkLatency rdf:type owl:DatatypeProperty ;
                rdfs:domain :Link ;
                rdfs:range xsd:integer .

# VNF Properties
:requiresCPU rdf:type owl:DatatypeProperty ;
             rdfs:domain :VNF ;
             rdfs:range xsd:integer .

:requiresLatency rdf:type owl:DatatypeProperty ;
                 rdfs:domain :VNF ;
                 rdfs:range xsd:integer .

:requiresHardwareAccel rdf:type owl:DatatypeProperty ;
                       rdfs:domain :VNF ;
                       rdfs:range xsd:boolean .