@prefix : <http://example.org/nfv-infra#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .

<http://example.org/nfv-infra#> rdf:type owl:Ontology ;
    owl:versionInfo "1.0 - Semantic-Aware VNF Placement Ontology (Phan et al., 2026)" ;
    rdfs:comment "OWL 2 EL ontology for RDF-based VNF placement in 5G/6G networks" .

# CLASSES
:Server rdf:type owl:Class .
:EdgeServer rdf:type owl:Class ; rdfs:subClassOf :Server .
:CoreServer rdf:type owl:Class ; rdfs:subClassOf :Server .
:VNF rdf:type owl:Class .
:LowLatencyVNF rdf:type owl:Class ; rdfs:subClassOf :VNF .
:HardwareAcceleratedVNF rdf:type owl:Class ; rdfs:subClassOf :VNF .
:Zone rdf:type owl:Class .
:LowLatencyZone rdf:type owl:Class ; rdfs:subClassOf :Zone .
:CoreZone rdf:type owl:Class ; rdfs:subClassOf :Zone .
:SecurityDomain rdf:type owl:Class ; rdfs:subClassOf :Zone .
:Node rdf:type owl:Class ; rdfs:subClassOf :Server .
:IncompatibleNode rdf:type owl:Class .

# PROPERTIES
:hasAvailableCPU rdf:type owl:DatatypeProperty ; rdfs:domain :Server ; rdfs:range xsd:integer .
:hasAvailableMemory rdf:type owl:DatatypeProperty ; rdfs:domain :Server ; rdfs:range xsd:integer .
:hasBandwidth rdf:type owl:DatatypeProperty ; rdfs:domain :Server ; rdfs:range xsd:integer .
:hasHardwareAccel rdf:type owl:DatatypeProperty ; rdfs:domain :Server ; rdfs:range xsd:boolean .
:hasLatency rdf:type owl:DatatypeProperty ; rdfs:domain :Server ; rdfs:range xsd:integer .
:locatedIn rdf:type owl:ObjectProperty ; rdfs:domain :Server ; rdfs:range :Zone .
:requiresCPU rdf:type owl:DatatypeProperty ; rdfs:domain :VNF ; rdfs:range xsd:integer .
:requiresHardwareAccel rdf:type owl:DatatypeProperty ; rdfs:domain :VNF ; rdfs:range xsd:boolean .
:requiresLatency rdf:type owl:DatatypeProperty ; rdfs:domain :VNF ; rdfs:range xsd:integer .
:belongsToSecurityDomain rdf:type owl:ObjectProperty ; rdfs:domain :VNF ; rdfs:range :SecurityDomain .
:mustPlaceOn rdf:type owl:ObjectProperty ; rdfs:domain :VNF ; rdfs:range :Server .
:lacksCapability rdf:type owl:ObjectProperty ; rdfs:domain :Node ; rdfs:range :Node .

# DL AXIOM: IncompatibleNode (Fixed)
:IncompatibleNode owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Node
        [ rdf:type owl:Class ;
          owl:unionOf (
              [ rdf:type owl:Restriction ; owl:onProperty :hasLatency ; owl:hasValue "high" ]
              [ rdf:type owl:Restriction ; owl:onProperty :lacksCapability ; owl:someValuesFrom :HardwareAcceleratedVNF ]
          )
        ]
    )
] .

# SWRL Rule 1 
:rule1 rdf:type swrl:Imp ;
    swrl:body [
        rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :LowLatencyVNF ; swrl:argument1 :v ] ;
        rdf:rest [
            rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :requiresLatency ; swrl:argument1 :v ; swrl:argument2 :l ] ;
            rdf:rest [
                rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Server ; swrl:argument1 :n ] ;
                rdf:rest rdf:nil
            ]
        ]
    ] ;
    swrl:head [ rdf:type swrl:AtomList ; rdf:first [ rdf:type swrl:ObjectPropertyAtom ; swrl:propertyPredicate :mustPlaceOn ; swrl:argument1 :v ; swrl:argument2 :n ] ; rdf:rest rdf:nil ] .
    
# SWRL Rule 2: HardwareAcceleratedVNF yêu cầu phần cứng (HardwareAccel = true)
# Nếu VNF yêu cầu tăng tốc phần cứng mà Server không cung cấp, thì Server đó là IncompatibleNode.
:rule2 rdf:type swrl:Imp ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :HardwareAcceleratedVNF ; swrl:argument1 :?v ] ;
        rdf:rest [ rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :requiresHardwareAccel ; swrl:argument1 :?v ; swrl:argument2 true ] ;
        rdf:rest [ rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Server ; swrl:argument1 :?n ] ;
        rdf:rest [ rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :hasHardwareAccel ; swrl:argument1 :?n ; swrl:argument2 false ] ;
        rdf:rest rdf:nil ] ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :IncompatibleNode ; swrl:argument1 :?n ] ;
        rdf:rest rdf:nil ] .

# SWRL Rule 3: Security isolation
# Nếu VNF thuộc một miền bảo mật mà Server không nằm trong đó, Server đó là IncompatibleNode.
:rule3 rdf:type swrl:Imp ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :VNF ; swrl:argument1 :?v ] ;
        rdf:rest [ rdf:first [ rdf:type swrl:ObjectPropertyAtom ; swrl:propertyPredicate :belongsToSecurityDomain ; swrl:argument1 :?v ; swrl:argument2 :?d1 ] ;
        rdf:rest [ rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Server ; swrl:argument1 :?n ] ;
        rdf:rest [ rdf:first [ rdf:type swrl:ObjectPropertyAtom ; swrl:propertyPredicate :locatedIn ; swrl:argument1 :?n ; swrl:argument2 :?d2 ] ;
        rdf:rest [ rdf:first [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:notEqual ; swrl:arguments ( :?d1 :?d2 ) ] ;
        rdf:rest rdf:nil ] ] ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :IncompatibleNode ; swrl:argument1 :?n ] ;
        rdf:rest rdf:nil ] .


# SWRL Rule 4: Phát hiện Node bị quá tải (Insufficient CPU)
:rule4 rdf:type swrl:Imp ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :VNF ; swrl:argument1 :?v ] ;
        rdf:rest [ rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :requiresCPU ; swrl:argument1 :?v ; swrl:argument2 :?reqCPU ] ;
        rdf:rest [ rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Server ; swrl:argument1 :?n ] ;
        rdf:rest [ rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :hasAvailableCPU ; swrl:argument1 :?n ; swrl:argument2 :?availCPU ] ;
        rdf:rest [ rdf:first [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( :?reqCPU :?availCPU ) ] ;
        rdf:rest rdf:nil ] ] ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :IncompatibleNode ; swrl:argument1 :?n ] ;
        rdf:rest rdf:nil ] .        