# Sample VNFs
:FirewallVNF rdf:type :LowLatencyVNF ;
    :requiresCPU 4 ;
    :requiresHardwareAccel true ;
    :requiresLatency 5 ;
    :belongsToSecurityDomain :TrustedDomain .

:LoadBalancerVNF rdf:type :HardwareAcceleratedVNF ;
    :requiresCPU 8 ;
    :requiresHardwareAccel true ;
    :requiresLatency 3 ;
    :belongsToSecurityDomain :TrustedDomain .

# Security domains
:TrustedDomain rdf:type :SecurityDomain .
:UntrustedDomain rdf:type :SecurityDomain .

# Zones
:LowLatencyZoneA rdf:type :LowLatencyZone .
:LowLatencyZoneB rdf:type :LowLatencyZone .
:CoreZone rdf:type :CoreZone .