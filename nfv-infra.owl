@prefix : <http://example.org/nfv-infra#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .

# =============================================
# ONTOLOGY HEADER
# =============================================
: nfvinfra rdf:type owl:Ontology ;
    owl:versionInfo "1.0 - Semantic-Aware VNF Placement Ontology (Phan et al., 2026)" ;
    rdfs:comment "OWL 2 EL ontology for RDF-based VNF placement in 5G/6G networks" .

# =============================================
# CLASSES (14 classes + hierarchy)
# =============================================
:Server          rdf:type owl:Class .
:EdgeServer      rdf:type owl:Class ; rdfs:subClassOf :Server .
:CoreServer      rdf:type owl:Class ; rdfs:subClassOf :Server .
:VNF             rdf:type owl:Class .
:LowLatencyVNF   rdf:type owl:Class ; rdfs:subClassOf :VNF .
:HardwareAcceleratedVNF rdf:type owl:Class ; rdfs:subClassOf :VNF .
:Zone            rdf:type owl:Class .
:LowLatencyZone  rdf:type owl:Class ; rdfs:subClassOf :Zone .
:CoreZone        rdf:type owl:Class ; rdfs:subClassOf :Zone .
:SecurityDomain  rdf:type owl:Class ; rdfs:subClassOf :Zone .
:Node            rdf:type owl:Class ; rdfs:subClassOf :Server .
:IncompatibleNode rdf:type owl:Class .

# =============================================
# PROPERTIES (12 properties)
# =============================================
:hasAvailableCPU         rdf:type owl:DatatypeProperty ;
    rdfs:domain :Server ; rdfs:range xsd:integer .
:hasAvailableMemory      rdf:type owl:DatatypeProperty ;
    rdfs:domain :Server ; rdfs:range xsd:integer .
:hasBandwidth            rdf:type owl:DatatypeProperty ;
    rdfs:domain :Server ; rdfs:range xsd:integer .
:hasHardwareAccel        rdf:type owl:DatatypeProperty ;
    rdfs:domain :Server ; rdfs:range xsd:boolean .
:hasLatency              rdf:type owl:DatatypeProperty ;
    rdfs:domain :Server ; rdfs:range xsd:integer .
:locatedIn               rdf:type owl:ObjectProperty ;
    rdfs:domain :Server ; rdfs:range :Zone .
:requiresCPU             rdf:type owl:DatatypeProperty ;
    rdfs:domain :VNF ; rdfs:range xsd:integer .
:requiresHardwareAccel   rdf:type owl:DatatypeProperty ;
    rdfs:domain :VNF ; rdfs:range xsd:boolean .
:requiresLatency         rdf:type owl:DatatypeProperty ;
    rdfs:domain :VNF ; rdfs:range xsd:integer .
:belongsToSecurityDomain rdf:type owl:ObjectProperty ;
    rdfs:domain :VNF ; rdfs:range :SecurityDomain .
:mustPlaceOn             rdf:type owl:ObjectProperty ;
    rdfs:domain :VNF ; rdfs:range :Server .
:lacksCapability         rdf:type owl:ObjectProperty ;
    rdfs:domain :Node ; rdfs:range :Node .

# =============================================
# DL AXIOM: IncompatibleNode
# =============================================
:IncompatibleNode owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        :Node
        [ rdf:type owl:Class ;
          owl:unionOf (
              [ rdf:type owl:Restriction ;
                owl:onProperty :hasLatency ;
                owl:hasValue "high"^^xsd:string ]
              [ rdf:type owl:Restriction ;
                owl:onProperty :lacksCapability ;
                owl:someValuesFrom :HardwareAcceleratedVNF ]
          )
        ]
    )
] .

# =============================================
# SWRL RULES (4 rules - 48 triples)
# =============================================

# SWRL Rule 1: Low-latency VNF must be placed on LowLatencyZone
:rule1 rdf:type swrl:Imp ;
    swrl:body [
        rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :LowLatencyVNF ; swrl:argument1 :?v ] ;
        rdf:rest [
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :requiresLatency ; swrl:argument1 :?v ; swrl:argument2 :?l ] ;
            rdf:rest [
                rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Server ; swrl:argument1 :?n ] ;
                rdf:rest [
                    rdf:first [ rdf:type swrl:ObjectPropertyAtom ; swrl:propertyPredicate :locatedIn ; swrl:argument1 :?n ; swrl:argument2 :?z ] ;
                    rdf:rest [
                        rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :LowLatencyZone ; swrl:argument1 :?z ] ;
                        rdf:rest [
                            rdf:first [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:lessThanOrEqual ; swrl:arguments ( :?l "5"^^xsd:integer ) ] ;
                            rdf:rest rdf:nil
                        ]
                    ]
                ]
            ]
        ]
    ] ;
    swrl:head [
        rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ObjectPropertyAtom ; swrl:propertyPredicate :mustPlaceOn ; swrl:argument1 :?v ; swrl:argument2 :?n ] ;
        rdf:rest rdf:nil
    ] .

# SWRL Rule 2: HardwareAcceleratedVNF requires hasHardwareAccel = true
:rule2 rdf:type swrl:Imp ;
    swrl:body [
        rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :HardwareAcceleratedVNF ; swrl:argument1 :?v ] ;
        rdf:rest [
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :requiresHardwareAccel ; swrl:argument1 :?v ; swrl:argument2 true ] ;
            rdf:rest [
                rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Server ; swrl:argument1 :?n ] ;
                rdf:rest [
                    rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :hasHardwareAccel ; swrl:argument1 :?n ; swrl:argument2 false ] ;
                    rdf:rest rdf:nil
                ]
            ]
        ]
    ] ;
    swrl:head [
        rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :IncompatibleNode ; swrl:argument1 :?n ] ;
        rdf:rest rdf:nil
    ] .

# SWRL Rule 3: Security isolation
:rule3 rdf:type swrl:Imp ;
    swrl:body [
        rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :VNF ; swrl:argument1 :?v ] ;
        rdf:rest [
            rdf:first [ rdf:type swrl:ObjectPropertyAtom ; swrl:propertyPredicate :belongsToSecurityDomain ; swrl:argument1 :?v ; swrl:argument2 :?d1 ] ;
            rdf:rest [
                rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Server ; swrl:argument1 :?n ] ;
                rdf:rest [
                    rdf:first [ rdf:type swrl:ObjectPropertyAtom ; swrl:propertyPredicate :locatedIn ; swrl:argument1 :?n ; swrl:argument2 :?d2 ] ;
                    rdf:rest [
                        rdf:first [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:notEqual ; swrl:arguments ( :?d1 :?d2 ) ] ;
                        rdf:rest rdf:nil
                    ]
                ]
            ]
        ]
    ] ;
    swrl:head [
        rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :IncompatibleNode ; swrl:argument1 :?n ] ;
        rdf:rest rdf:nil
    ] .

# SWRL Rule 4: Overloaded node detection (example for pruning)
:rule4 rdf:type swrl:Imp ;
    swrl:body [
        rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Server ; swrl:argument1 :?n ] ;
        rdf:rest [
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :hasAvailableCPU ; swrl:argument1 :?n ; swrl:argument2 :?c ] ;
            rdf:rest [
                rdf:first [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ; swrl:arguments ( :?c "2"^^xsd:integer ) ] ;
                rdf:rest rdf:nil
            ]
        ]
    ] ;
    swrl:head [
        rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :IncompatibleNode ; swrl:argument1 :?n ] ;
        rdf:rest rdf:nil
    ] .

# =============================================
# SAMPLE INDIVIDUALS (12 nodes + 2 VNF examples)
# =============================================
:EdgeNode1 rdf:type :EdgeServer ;
    :hasAvailableCPU 8 ;
    :hasAvailableMemory 16384 ;
    :hasBandwidth 1000 ;
    :hasHardwareAccel true ;
    :hasLatency 2 ;
    :locatedIn :LowLatencyZoneA .

